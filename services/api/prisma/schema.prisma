model MarketplaceDispute {
  id                     String                        @id @default(uuid()) @db.Uuid
  transactionId          String                        @db.Uuid
  paymentId              String?                       @db.Uuid
  fulfilmentId           String?                       @db.Uuid
  openedById             String                        @db.Uuid
  buyerId                String                        @db.Uuid
  sellerId               String                        @db.Uuid
  assignedToId           String?                       @db.Uuid
  reason                 MarketplaceDisputeReason
  status                 MarketplaceDisputeStatus      @default(OPEN)
  priority               MarketplaceDisputePriority    @default(NORMAL)
  title                  String
  description            String
  requestedResolution    String?
  proposedResolution     String?
  resolution             MarketplaceDisputeResolution?
  resolutionDecision     String?
  resolutionInstructions String?
  refundAmountPence      Int?
  responseDueAt          DateTime?
  firstResponseAt        DateTime?
  reviewStartedAt        DateTime?
  escalatedAt            DateTime?
  resolvedAt             DateTime?
  closedAt               DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  transaction MarketplaceTransaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  payment     MarketplacePayment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  fulfilment  MarketplaceFulfilment?       @relation(fields: [fulfilmentId], references: [id], onDelete: SetNull)
  openedBy    User                         @relation("MarketplaceDisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  buyer       User                         @relation("MarketplaceDisputeBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller      User                         @relation("MarketplaceDisputeSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  assignedTo  User?                        @relation("MarketplaceDisputeAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  evidence    MarketplaceDisputeEvidence[]
  messages    MarketplaceDisputeMessage[]
  events      MarketplaceDisputeEvent[]

  @@index([transactionId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([openedById, createdAt])
  @@index([assignedToId, status])
  @@index([status, priority, createdAt])
  @@index([responseDueAt, status])
  @@index([paymentId])
  @@index([fulfilmentId])
  @@map("marketplace_disputes")
}

