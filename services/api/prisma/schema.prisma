  seller                User                      @relation("MarketplacePaymentSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  refunds               MarketplaceRefund[]
  events                MarketplacePaymentEvent[]
  marketplaceDisputes   MarketplaceDispute[]
  marketplaceSettlement MarketplaceSettlement?

  @@unique([transactionId, id])
  @@index([transactionId, status, createdAt])
  @@index([buyerId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([provider, providerReference])
  @@index([status, expiresAt])
  @@map("marketplace_payments")
}

