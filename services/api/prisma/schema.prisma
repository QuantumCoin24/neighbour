enum MarketplaceSettlementStatus {
  PENDING
  AVAILABLE
  PAID_OUT
  REVERSED
}

model MarketplaceSettlement {
  id            String                      @id @default(uuid()) @db.Uuid
  paymentId     String                      @unique @db.Uuid
  transactionId String                      @db.Uuid
  sellerId      String                      @db.Uuid
  status        MarketplaceSettlementStatus @default(PENDING)

  grossAmountPence    Int
  platformFeePence    Int
  processorFeePence   Int
  sellerProceedsPence Int
  refundedAmountPence Int @default(0)

  currency          String                     @default("GBP")
  provider          MarketplacePaymentProvider
  providerReference String?

  capturedAt  DateTime
  availableAt DateTime?
  paidOutAt   DateTime?
  reversedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment     MarketplacePayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transaction MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  seller      User                   @relation("MarketplaceSettlementSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId, status, createdAt])
  @@index([transactionId])
  @@index([status, createdAt])
  @@index([provider, providerReference])
  @@map("marketplace_settlements")
}
