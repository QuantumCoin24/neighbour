model User {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique
  displayName              String
  passwordHash             String
  role                     PlatformRole              @default(USER)
  status                   UserStatus                @default(ACTIVE)
  emailVerifiedAt          DateTime?
  memberships              Membership[]
  profile                  UserProfile?
  refreshTokens            RefreshToken[]
  connectionsAsUserA       Connection[]              @relation("ConnectionUserA")
  connectionsAsUserB       Connection[]              @relation("ConnectionUserB")
  requestedConnections     Connection[]              @relation("ConnectionRequester")
  blocksCreated            UserBlock[]               @relation("Blocker")
  blocksReceived           UserBlock[]               @relation("Blocked")
  posts                    Post[]
  comments                 Comment[]
  postReactions            PostReaction[]
  reportsSubmitted         Report[]                  @relation("ReportReporter")
  moderationActions        ModerationAction[]        @relation("ModerationModerator")
  notificationsReceived    Notification[]            @relation("NotificationRecipient")
  notificationsActed       Notification[]            @relation("NotificationActor")
  conversationsOwned       Conversation[]            @relation("ConversationOwner")
  conversationMembers      ConversationMember[]
  messagesSent             Message[]                 @relation("MessageSender")
  messageReadReceipts      MessageReadReceipt[]
  pushDevices              PushDevice[]
  neighbourhoodMemberships NeighbourhoodMembership[]
  attendances              Attendance[]
  createdEvents            Event[]
  businesses               Business[]
  organisations            Organisation[]
  organisationMemberships  OrganisationMember[]
  businessVerifications    BusinessVerification[]    @relation("BusinessVerificationReviewer")
  subscriptions            Subscription[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  marketplaceListings             MarketplaceListing[]
  savedMarketplaceListings        SavedMarketplaceListing[]
  marketplaceOffersMade           MarketplaceOffer[]           @relation("MarketplaceOfferBuyer")
  marketplaceOffersReceived       MarketplaceOffer[]           @relation("MarketplaceOfferSeller")
  marketplaceTransactionsAsBuyer  MarketplaceTransaction[]     @relation("MarketplaceTransactionBuyer")
  marketplaceTransactionsAsSeller MarketplaceTransaction[]     @relation("MarketplaceTransactionSeller")
  marketplaceFulfilmentEvents     MarketplaceFulfilmentEvent[]
  marketplaceFulfilmentProofs     MarketplaceFulfilmentProof[]

  marketplacePaymentsAsBuyer  MarketplacePayment[]      @relation("MarketplacePaymentBuyer")
  marketplacePaymentsAsSeller MarketplacePayment[]      @relation("MarketplacePaymentSeller")
  marketplacePaymentEvents    MarketplacePaymentEvent[]
  marketplaceRefundRequests   MarketplaceRefund[]       @relation("MarketplaceRefundRequestedBy")

  marketplaceReviewsWritten    MarketplaceReview[]           @relation("MarketplaceReviewReviewer")
  marketplaceReviewsReceived   MarketplaceReview[]           @relation("MarketplaceReviewSubject")
  marketplaceReputationProfile MarketplaceReputationProfile?
  marketplaceReputationEvents  MarketplaceReputationEvent[]
  marketplaceReputationBadges  MarketplaceReputationBadge[]
  marketplaceReviewReports     MarketplaceReviewReport[]

  marketplaceDisputesOpened   MarketplaceDispute[]         @relation("MarketplaceDisputeOpenedBy")
  marketplaceDisputesAsBuyer  MarketplaceDispute[]         @relation("MarketplaceDisputeBuyer")
  marketplaceDisputesAsSeller MarketplaceDispute[]         @relation("MarketplaceDisputeSeller")
  marketplaceDisputesAssigned MarketplaceDispute[]         @relation("MarketplaceDisputeAssignee")
  marketplaceDisputeEvidence  MarketplaceDisputeEvidence[]
  marketplaceDisputeMessages  MarketplaceDisputeMessage[]
  marketplaceDisputeEvents    MarketplaceDisputeEvent[]

  marketplaceModerationCasesOpened   MarketplaceModerationCase[]   @relation("MarketplaceModerationOpenedBy")
  marketplaceModerationCasesReported MarketplaceModerationCase[]   @relation("MarketplaceModerationReportedUser")
  marketplaceModerationCasesAssigned MarketplaceModerationCase[]   @relation("MarketplaceModerationAssignee")
  marketplaceModerationActions       MarketplaceModerationAction[]
  marketplaceModerationAppeals       MarketplaceModerationAppeal[]
  marketplaceModerationEvents        MarketplaceModerationEvent[]
  marketplaceFraudSignalsCreated     MarketplaceFraudSignal[]
  marketplaceSettlements             MarketplaceSettlement[]       @relation("MarketplaceSettlementSeller")

  @@index([status])
  @@index([role])
  @@map("users")
}

model UserProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  username      String   @unique
  bio           String?
  avatarUrl     String?
  localArea     String?
  showLocalArea Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([username])
  @@index([showLocalArea])
  @@map("user_profiles")
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  plan     SubscriptionPlan     @default(FREE)
  status   SubscriptionStatus   @default(ACTIVE)
  provider SubscriptionProvider @default(INTERNAL)

  externalReference String?
  startedAt         DateTime  @default(now())
  currentPeriodEnd  DateTime?
  cancelledAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([plan])
  @@index([provider])
  @@map("subscriptions")
}

model Neighbourhood {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String
  localArea   String?

  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  locationAccuracyM  Int?
  addressLine1       String?
  addressLine2       String?
  city               String?
  postcode           String?
  locationVisibility LocationVisibility @default(PUBLIC)

  memberships NeighbourhoodMembership[]
  posts       Post[]
  communities Community[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localArea])
  @@index([latitude, longitude])
  @@index([postcode])
  @@index([locationVisibility])
  @@map("neighbourhoods")
}

model NeighbourhoodMembership {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @db.Uuid
  neighbourhoodId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  neighbourhood Neighbourhood @relation(fields: [neighbourhoodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, neighbourhoodId])
  @@index([userId])
  @@index([neighbourhoodId])
  @@map("neighbourhood_memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Community {
  id               String              @id @default(uuid()) @db.Uuid
  neighbourhoodId  String?             @db.Uuid
  name             String
  slug             String              @unique
  description      String?
  shortDescription String?
  handle           String              @unique
  category         CommunityCategory   @default(LOCAL_AREA)
  tags             String[]            @default([])
  welcomeMessage   String?
  rules            String[]            @default([])
  logoUrl          String?
  bannerUrl        String?
  accentColour     String?
  joinPolicy       CommunityJoinPolicy @default(OPEN)
  approvalRequired Boolean             @default(false)
  allowMemberPosts Boolean             @default(true)
  allowBusinesses  Boolean             @default(true)
  allowMarketplace Boolean             @default(true)
  allowEvents      Boolean             @default(true)
  discoverable     Boolean             @default(true)

  latitude           Decimal?            @db.Decimal(9, 6)
  longitude          Decimal?            @db.Decimal(9, 6)
  locationAccuracyM  Int?
  addressLine1       String?
  addressLine2       String?
  city               String?
  postcode           String?
  locationVisibility LocationVisibility  @default(PUBLIC)
  visibility         CommunityVisibility @default(PUBLIC)
  memberships        Membership[]
  notifications      Notification[]
  conversations      Conversation[]
  posts              Post[]
  events             Event[]
  businesses         Business[]

  neighbourhood Neighbourhood? @relation(fields: [neighbourhoodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketplaceListings MarketplaceListing[]

  @@index([visibility])
  @@index([category])
  @@index([handle])
  @@index([discoverable])
  @@index([city, postcode])
  @@index([latitude, longitude])
  @@index([postcode])
  @@index([locationVisibility])
  @@map("communities")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  communityId String           @db.Uuid
  role        MembershipRole   @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId, status])
  @@index([userId, status])
  @@map("memberships")
}

model Connection {
  id            String           @id @default(uuid()) @db.Uuid
  userAId       String           @db.Uuid
  userBId       String           @db.Uuid
  requestedById String           @db.Uuid
  status        ConnectionStatus @default(PENDING)
  respondedAt   DateTime?
  connectedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userA         User             @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User             @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)
  requestedBy   User             @relation("ConnectionRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
  @@index([requestedById, status])
  @@map("connections")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Post {
  id              String         @id @default(uuid()) @db.Uuid
  authorId        String         @db.Uuid
  communityId     String?        @db.Uuid
  neighbourhoodId String?        @db.Uuid
  comments        Comment[]
  reactions       PostReaction[]
  notifications   Notification[]
  media           PostMedia[]
  title           String?
  type            PostType       @default(STANDARD)
  isPinned        Boolean        @default(false)
  metadata        Json?
  content         String
  status          PostStatus     @default(DRAFT)
  visibility      PostVisibility @default(PUBLIC)
  publishedAt     DateTime?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community       Community?     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id], onDelete: Cascade)

  @@index([authorId, status, publishedAt])
  @@index([communityId, status, publishedAt])
  @@index([communityId, type, status, publishedAt])
  @@index([communityId, isPinned, publishedAt])
  @@index([neighbourhoodId, status, publishedAt])
  @@index([status, visibility, publishedAt])
  @@index([deletedAt])
  @@map("posts")
}

model Comment {
  id            String         @id @default(uuid()) @db.Uuid
  postId        String         @db.Uuid
  authorId      String         @db.Uuid
  parentId      String?        @db.Uuid
  content       String
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?       @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]      @relation("CommentReplies")
  notifications Notification[]

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId, createdAt])
  @@index([deletedAt])
  @@map("comments")
}

model PostReaction {
  id        String       @id @default(uuid()) @db.Uuid
  postId    String       @db.Uuid
  userId    String       @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId, type])
  @@index([userId, createdAt])
  @@map("post_reactions")
}

model Conversation {
  id            String               @id @default(uuid()) @db.Uuid
  type          ConversationType
  title         String?
  ownerId       String               @db.Uuid
  communityId   String?              @db.Uuid
  directKey     String?              @unique
  lastMessageId String?              @unique @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  owner         User                 @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  community     Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members       ConversationMember[]
  messages      Message[]            @relation("ConversationMessages")
  lastMessage   Message?             @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([ownerId, updatedAt])
  @@index([communityId, updatedAt])
  @@index([type, updatedAt])
  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationMember {
  id                String                 @id @default(uuid()) @db.Uuid
  conversationId    String                 @db.Uuid
  userId            String                 @db.Uuid
  role              ConversationMemberRole @default(MEMBER)
  joinedAt          DateTime               @default(now())
  leftAt            DateTime?
  archivedAt        DateTime?
  mutedUntil        DateTime?
  pinnedAt          DateTime?
  lastReadMessageId String?                @db.Uuid
  lastReadAt        DateTime?
  unreadCount       Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
