NODE_ENV=development
APP_ENV=local
API_PORT=4000
WEB_PORT=3000

DATABASE_URL=postgresql://neighbour:neighbour_local_password@localhost:5432/neighbour
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_BUCKET=neighbour-local
S3_ACCESS_KEY=neighbour
S3_SECRET_KEY=change-this-local-secret
S3_FORCE_PATH_STYLE=true

JWT_ISSUER=neighbour.local
JWT_AUDIENCE=neighbour-platform
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

LOG_LEVEL=debug
