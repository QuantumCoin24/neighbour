NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0-rc.1
DATABASE_URL=postgresql://neighbour:neighbour_local_password@localhost:5432/neighbour?schema=public
JWT_ACCESS_SECRET=neighbour_local_access_secret_change_me_32_chars
JWT_REFRESH_SECRET=neighbour_local_refresh_secret_change_me_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# MediaOS — S3-compatible object storage
MEDIA_S3_ENDPOINT=https://YOUR-ENDPOINT
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=neighbour-media
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=https://media.example.com

# Apple StoreKit and App Store Server Notifications
APPLE_BUNDLE_ID=com.quantumcoin24.neighbour
APPLE_IAP_ENVIRONMENT=Sandbox
